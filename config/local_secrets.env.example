# Local secrets (example only)

# Copy to config/local_secrets.env and fill in values.
# config/local_secrets.env is gitignored — never commit real credentials.
#
# FR-019 mailbox intake (Yahoo IMAP). Environment variables with the same names
# override values from this file when set (environment wins).

CIC_MAILBOX_HOST=imap.mail.yahoo.com
CIC_MAILBOX_PORT=993
CIC_MAILBOX_USER=
CIC_MAILBOX_APP_PASSWORD=
CIC_MAILBOX_FOLDER=CIC Job Alerts

# Optional drop-folder for .eml fallback (dev / recovery — not production headline):
# CIC_MAILBOX_DROP_FOLDER=

# Optional (default false / leave unread — preferred):
# CIC_MAILBOX_MARK_SEEN=false
